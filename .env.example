# GitHub Token（强烈建议配置）：匿名访问 GitHub API 限额仅 60 次/小时，极易触发 403 限流。
# 任意无权限的 classic token (ghp_) 或 fine-grained token (github_pat_) 即可，限额提升至 5000 次/小时。
# 生成地址: https://github.com/settings/tokens
GITHUB_TOKEN=

VITE_MAX_COMMITS_FOR_FULL_DIFF=100
VITE_MAX_FILES_FOR_FULL_DIFF=50
VITE_MAX_PRIORITY_FILES_FOR_SEGMENTED_DIFF=15
VITE_BATCH_ANALYSIS_FILE_BATCH_SIZE=10
VITE_MAX_FILES_FOR_BATCH_ANALYSIS=500
