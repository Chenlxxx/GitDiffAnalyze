# GitHub Token（强烈建议配置）：匿名访问 GitHub API 限额仅 60 次/小时，极易触发 403 限流。
# 任意无权限的 classic token (ghp_) 或 fine-grained token (github_pat_) 即可，限额提升至 5000 次/小时。
# 生成地址: https://github.com/settings/tokens
GITHUB_TOKEN=

# ===== 服务端默认模型供应商（可选，适用于 Render 等部署平台）=====
# 配置齐 DEFAULT_AI_API_KEY + DEFAULT_AI_MODEL 后，前端会自动出现
# 「平台默认（服务端配置）」供应商，访客无需自己填 Key 即可分析；
# Key 只存在服务端，经代理请求时注入，绝不下发到浏览器。
DEFAULT_AI_API_KEY=
# 模型名称，如 qwen-plus / deepseek-chat / gpt-4o
DEFAULT_AI_MODEL=
# Base URL，如 https://dashscope.aliyuncs.com/compatible-mode/v1（OpenAI 官方可留空）
DEFAULT_AI_BASE_URL=
# 接口协议：openai | anthropic | gemini（默认 openai，绝大多数国内厂商用 openai）
DEFAULT_AI_PROTOCOL=openai

VITE_MAX_COMMITS_FOR_FULL_DIFF=100
VITE_MAX_FILES_FOR_FULL_DIFF=50
VITE_MAX_PRIORITY_FILES_FOR_SEGMENTED_DIFF=15
VITE_BATCH_ANALYSIS_FILE_BATCH_SIZE=10
# AI 批次分析并行度（默认 4）：调高更快但易触发模型限流
VITE_AI_BATCH_CONCURRENCY=4
VITE_MAX_FILES_FOR_BATCH_ANALYSIS=500
